# Appended to /root/caddy/Caddyfile on Luma001 (Caddy mounts /root/caddy/static at /srv/static).
hermit-stats.com {
    root * /srv/static/hermit-stats
    encode zstd gzip
    @revalidate not path /avatars/*
    header @revalidate Cache-Control "no-cache"
    header /avatars/* Cache-Control "public, max-age=604800"
    file_server
}
www.hermit-stats.com {
    redir https://hermit-stats.com{uri} permanent
}
